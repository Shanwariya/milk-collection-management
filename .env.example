# ===================================================
# Milk Collection Management System - Environment Template
# ===================================================

# ---------------------------------------------------
# BACKEND SERVER ENVIRONMENT VARIABLES
# ---------------------------------------------------
# REQUIRED IN PRODUCTION: PostgreSQL database connection string
DATABASE_URL=postgresql://username:password@hostname:5432/dbname?sslmode=require

# Backend Port
PORT=5000

# Server Environment Mode ('production' or 'development')
NODE_ENV=production

# JWT Authentication Secret Key (Random secure string)
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# CORS Configuration (Allowed Production Frontend Origins, comma-separated)
CORS_ORIGIN=https://your-app.vercel.app

# ---------------------------------------------------
# FRONTEND ENVIRONMENT VARIABLES (VITE)
# ---------------------------------------------------
# Frontend API Endpoint Base URL (Configured in Vercel/Hosting Dashboard)
VITE_API_URL=https://your-api.onrender.com/api
